# Postgres connection string (run history). Provision via Neon on the
# Vercel Marketplace (`vercel install neon`) or any Postgres provider.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Vercel Blob read/write token (evidence screenshots). Provision via
# `vercel blob create-store <name> --access public` and link it to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx

# Browser Use Cloud API (https://cloud.browser-use.com/settings)
BROWSER_USE_API_KEY=bu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: LLM used by the Browser Use agent — must be one of the enum values in
# GET https://api.browser-use.com/api/v4/openapi.json (e.g. gpt-5.6-luna, claude-sonnet-5).
# Leave unset to use Browser Use's own default.
# BROWSER_USE_MODEL=

# Optional: real, API-enforced per-run cost cap in USD (maps to RunCreateRequest.maxCostUsd).
# Leave unset for no per-run cap.
# RUN_MAX_COST_USD=2

# SAP sandbox under test
SAP_URL=https://myXXXXXX.s4hana.cloud.sap/ui?sap-client=100
SAP_USERNAME=you@example.com
SAP_PASSWORD=change-me

# Soft guardrail only (client-side spend awareness, not enforced by the API)
BROWSER_USE_SPEND_CAP_USD=20

# Per-run wall-clock timeout enforced by the poller, in seconds. Real multi-dialog
# SAP flows (open a settings dialog, toggle, close, reopen, verify) observed taking
# 5-10 minutes end to end — 300s was too tight in practice; 600+ is safer.
RUN_TIMEOUT_SECONDS=600

# Set to "true" to use the offline stub Browser Use client (no API spend, fixed fake responses)
BROWSER_USE_STUB=false
