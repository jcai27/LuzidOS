# Browser Use Cloud API (https://cloud.browser-use.com/settings)
BROWSER_USE_API_KEY=bu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: LLM used by the Browser Use agent. Leave unset to use Browser Use's own default.
# BROWSER_USE_MODEL=

# SAP sandbox under test
SAP_URL=https://myXXXXXX.s4hana.cloud.sap/ui?sap-client=100
SAP_USERNAME=you@example.com
SAP_PASSWORD=change-me

# Soft guardrail only (client-side spend awareness, not enforced by the API)
BROWSER_USE_SPEND_CAP_USD=20

# Per-run wall-clock timeout enforced by the poller, in seconds
RUN_TIMEOUT_SECONDS=300

# Set to "true" to use the offline stub Browser Use client (no API spend, fixed fake responses)
BROWSER_USE_STUB=false
